# Server Port
PORT=5000

# MongoDB Connection String
# Replace with your Atlas URI or local connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/vexa_hub?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/vexa_hub
MONGO_URI=mongodb://localhost:27017/vexa_hub
MONGODB_URI=mongodb://localhost:27017/vexa_hub

# JWT Secret
JWT_SECRET=your_secret_jwt_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Nodemailer Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=VEXA Support <noreply@vexa.com>
CLIENT_URL=http://localhost:8080
